---
---

<div id="floating-widget" class="fixed bottom-6 right-6 z-50">
  <!-- Contact Options -->
  <div
    id="widget-options"
    class="absolute bottom-16 right-0 flex flex-col gap-3 opacity-0 pointer-events-none
           transform translate-y-4 transition-all duration-300"
  >
    <!-- Telegram -->
    <a
      href="https://t.me/+380677777230"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact us on Telegram"
      class="w-12 h-12 rounded-full bg-[#229ED9] flex items-center justify-center shadow-lg
             hover:scale-110 transition-transform duration-200"
    >
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
        <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
      </svg>
    </a>

    <!-- WhatsApp -->
    <a
      href="https://api.whatsapp.com/send/?phone=380677777230"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Contact us on WhatsApp"
      class="w-12 h-12 rounded-full bg-[#25D366] flex items-center justify-center shadow-lg
             hover:scale-110 transition-transform duration-200"
    >
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
    </a>

    <!-- Email -->
    <a
      href="mailto:ai@innovaconsult.ai"
      aria-label="Email us"
      class="w-12 h-12 rounded-full bg-brand-blue flex items-center justify-center shadow-lg
             hover:scale-110 transition-transform duration-200"
    >
      <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
    </a>
  </div>

  <!-- Main Toggle Button -->
  <button
    id="widget-toggle"
    aria-label="Open contact options"
    class="relative w-14 h-14 rounded-full bg-gradient-to-br from-brand-blue to-brand-cyan
           flex items-center justify-center shadow-xl shadow-brand-blue/30
           hover:shadow-brand-blue/50 transition-all duration-300 pulse-ring"
  >
    <!-- Chat icon -->
    <svg id="widget-icon-open" class="w-6 h-6 text-white transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z" />
    </svg>
    <!-- Close icon -->
    <svg id="widget-icon-close" class="w-6 h-6 text-white absolute opacity-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18" />
      <line x1="6" y1="6" x2="18" y2="18" />
    </svg>
  </button>
</div>

<script>
  const widgetToggle = document.getElementById('widget-toggle')!;
  const widgetOptions = document.getElementById('widget-options')!;
  const iconOpen = document.getElementById('widget-icon-open')!;
  const iconClose = document.getElementById('widget-icon-close')!;
  let isOpen = false;

  widgetToggle.addEventListener('click', () => {
    isOpen = !isOpen;

    if (isOpen) {
      widgetOptions.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
      widgetOptions.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
      iconOpen.classList.add('opacity-0', 'rotate-90');
      iconClose.classList.remove('opacity-0');
      iconClose.classList.add('rotate-0');
      widgetToggle.classList.remove('pulse-ring');
    } else {
      widgetOptions.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      widgetOptions.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
      iconOpen.classList.remove('opacity-0', 'rotate-90');
      iconClose.classList.add('opacity-0');
      iconClose.classList.remove('rotate-0');
    }
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    const widget = document.getElementById('floating-widget')!;
    if (isOpen && !widget.contains(e.target as Node)) {
      widgetToggle.click();
    }
  });
</script>
