---
const serviceLinks = [
  { label: 'AI Strategy & Roadmap', href: '#' },
  { label: 'LLM Integration', href: '#' },
  { label: 'AI Agents & Automation', href: '#' },
  { label: 'Custom AI Chatbots', href: '#' },
  { label: 'Crypto & FinTech AI', href: '#' },
  { label: 'AI-Powered SEO', href: '#' },
];

const companyLinks = [
  { label: 'About Us', href: '#why-us' },
  { label: 'Services', href: '#services' },
  { label: 'Case Studies', href: '#cases' },
  { label: 'Blog', href: '#blog' },
  { label: 'Contact', href: '#contact' },
];

const groupLinks = [
  { label: 'Crystal Tax', href: 'https://crystal.tax' },
  { label: 'MMIX Digital', href: 'https://mmix.ua' },
  { label: 'Legal.ua', href: 'https://legal.ua' },
  { label: 'CRMius', href: 'https://crmius.com' },
  { label: 'Unistaff AI', href: 'https://unistaff.ai' },
];
---

<footer class="bg-brand-dark border-t border-white/5" role="contentinfo">
  <div class="section-container py-12 lg:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-8">
      <!-- Brand Column -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href="/" class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-brand-blue to-brand-cyan flex items-center justify-center">
            <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z" />
              <path d="M2 17l10 5 10-5" />
              <path d="M2 12l10 5 10-5" />
            </svg>
          </div>
          <span class="text-lg font-heading font-bold text-white">
            Innova<span class="gradient-text">Consult</span>.ai
          </span>
        </a>
        <p class="text-brand-muted text-sm leading-relaxed mb-4">
          AI consulting and LLM integration for businesses. Part of Innova Consulting Group — 12+ years of expertise in tax, legal, fintech, and digital transformation.
        </p>
        <div class="flex items-center gap-4">
          <a href="https://t.me/+380677777230" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="text-brand-muted hover:text-brand-cyan transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </a>
          <a href="https://api.whatsapp.com/send/?phone=380677777230" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="text-brand-muted hover:text-green-400 transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          </a>
          <a href="mailto:ai@innovaconsult.ai" aria-label="Email" class="text-brand-muted hover:text-brand-blue transition-colors">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Services Links -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Services</h4>
        <ul class="space-y-2.5">
          {serviceLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-brand-muted hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Company</h4>
        <ul class="space-y-2.5">
          {companyLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-brand-muted hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Innova Group -->
      <div>
        <h4 class="font-heading font-semibold text-white mb-4">Innova Group</h4>
        <ul class="space-y-2.5">
          {groupLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-brand-muted hover:text-white transition-colors inline-flex items-center gap-1"
              >
                {link.label}
                <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                  <polyline points="15 3 21 3 21 9" />
                  <line x1="10" y1="14" x2="21" y2="3" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-sm text-brand-muted">
        &copy; 2026 InnovaConsult.ai — Part of Innova Consulting Group. All rights reserved.
      </p>
      <div class="flex items-center gap-6">
        <a href="#" class="text-xs text-brand-muted hover:text-white transition-colors">Privacy Policy</a>
        <a href="#" class="text-xs text-brand-muted hover:text-white transition-colors">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>
