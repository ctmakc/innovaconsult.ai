---
import BaseLayout from '../layouts/BaseLayout.astro';

const offerTracks = [
  {
    title: 'AI Strategy',
    text: 'Executive-level positioning, use-case selection, ROI framing, and rollout sequencing for teams that need clarity before they buy tools.'
  },
  {
    title: 'Workflow Automation',
    text: 'Design and implementation of agent-assisted operating flows for sales, operations, inboxes, knowledge work, and internal service desks.'
  },
  {
    title: 'LLM Delivery',
    text: 'Practical deployment of copilots, assistants, routing layers, evaluation loops, and human-approval workflows without demo-ware fluff.'
  }
];

const engagements = [
  '2-week audit sprint with prioritized roadmap',
  '6-week pilot to prove one production workflow',
  'Fractional AI transformation leadership for execution'
];

const faq = [
  {
    question: 'What kind of companies is this for?',
    answer: 'InnovaConsult.ai is built for owner-led businesses, service firms, and operating teams that want AI to improve throughput, response time, and decision quality.'
  },
  {
    question: 'Do you only advise, or do you implement?',
    answer: 'Both. We can stay at the strategy layer, but the default model is strategy plus delivery so recommendations become live systems.'
  },
  {
    question: 'What is the fastest path to value?',
    answer: 'A focused audit plus one high-friction workflow pilot. That gives a clear baseline, a production win, and evidence for broader rollout.'
  }
];

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'InnovaConsult.ai',
  url: 'https://innovaconsult.ai',
  email: 'hello@innovaconsult.ai',
  areaServed: 'Global',
  description:
    'AI consulting, workflow automation, and LLM implementation for ambitious operating teams.'
};
---

<BaseLayout
  title="InnovaConsult.ai | AI Consulting and Workflow Automation"
  description="AI consulting, workflow automation, and LLM implementation for ambitious operating teams."
>
  <main>
    <section class="relative overflow-hidden border-b border-cyan-500/20 bg-ink">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(34,211,238,0.22),transparent_28%),radial-gradient(circle_at_80%_0%,rgba(37,99,235,0.22),transparent_26%)]"></div>
      <div class="relative mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="inline-flex rounded-full border border-cyan-400/25 px-4 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-cyan-200">
          AI consulting for real operations
        </p>
        <h1 class="mt-6 max-w-4xl font-display text-5xl font-bold leading-tight text-white md:text-7xl">
          Build AI systems that change throughput, not just slide decks.
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-slate-300 md:text-xl">
          InnovaConsult.ai helps businesses turn AI ambition into production systems: better inbox handling,
          faster service operations, sharper sales follow-up, and cleaner executive visibility.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href="#contact"
            class="rounded-full bg-cyan-400 px-7 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            Book a Strategy Call
          </a>
          <a
            href="#offers"
            class="rounded-full border border-slate-700 px-7 py-3 font-semibold text-slate-100 transition hover:border-cyan-300 hover:text-cyan-200"
          >
            See Engagement Models
          </a>
        </div>
        <div class="mt-16 grid gap-4 md:grid-cols-3">
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">Outcome</p>
            <p class="mt-3 text-2xl font-semibold text-white">AI roadmap with operator reality baked in</p>
          </div>
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">Delivery</p>
            <p class="mt-3 text-2xl font-semibold text-white">Pilots, assistants, workflows, and decision loops</p>
          </div>
          <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur">
            <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">Bias</p>
            <p class="mt-3 text-2xl font-semibold text-white">Production first. Hype last.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="offers" class="mx-auto max-w-6xl px-6 py-20 md:py-24">
      <h2 class="section-title">What We Build</h2>
      <p class="section-subtitle">A focused advisory and delivery stack for companies that need execution, not theatre.</p>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {offerTracks.map((track) => (
          <article class="rounded-3xl border border-slate-800 bg-slate-900/80 p-7 shadow-card">
            <h3 class="font-display text-2xl font-semibold text-white">{track.title}</h3>
            <p class="mt-4 text-base leading-7 text-slate-300">{track.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="border-y border-slate-800 bg-slate-900/60">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-[1.2fr_0.8fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-200">How we engage</p>
          <h2 class="mt-4 font-display text-4xl font-semibold text-white">From audit to operator-owned rollout.</h2>
          <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
            The default path is simple: map friction, rank use cases, implement one workflow end to end, and then
            expand only after the first system proves itself in the real business.
          </p>
        </div>
        <div class="rounded-3xl border border-cyan-500/20 bg-slate-950/80 p-8">
          <ul class="space-y-4">
            {engagements.map((item) => (
              <li class="rounded-2xl border border-slate-800 px-5 py-4 text-base text-slate-200">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20">
      <div class="grid gap-8 md:grid-cols-3">
        <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-7">
          <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">01</p>
          <h3 class="mt-4 font-display text-2xl text-white">Audit the mess</h3>
          <p class="mt-4 text-slate-300">Map decisions, queues, exceptions, handoffs, and where work currently dies.</p>
        </div>
        <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-7">
          <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">02</p>
          <h3 class="mt-4 font-display text-2xl text-white">Ship one workflow</h3>
          <p class="mt-4 text-slate-300">Pilot a contained AI system that moves a measurable bottleneck in production.</p>
        </div>
        <div class="rounded-3xl border border-slate-800 bg-slate-900/80 p-7">
          <p class="text-sm uppercase tracking-[0.2em] text-cyan-200">03</p>
          <h3 class="mt-4 font-display text-2xl text-white">Scale with control</h3>
          <p class="mt-4 text-slate-300">Add governance, review loops, and rollout discipline so AI becomes dependable.</p>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-800 bg-slate-900/50">
      <div class="mx-auto max-w-4xl px-6 py-20">
        <h2 class="section-title">Questions We Usually Get</h2>
        <div class="mt-8 space-y-4">
          {faq.map((item) => (
            <details class="rounded-2xl border border-slate-800 bg-slate-950/70 p-6">
              <summary class="cursor-pointer text-lg font-semibold text-white">{item.question}</summary>
              <p class="mt-4 leading-7 text-slate-300">{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="contact" class="mx-auto max-w-6xl px-6 py-20">
      <div class="rounded-[2rem] border border-cyan-400/20 bg-gradient-to-br from-slate-900 to-slate-950 p-10 md:p-12">
        <p class="text-sm font-semibold uppercase tracking-[0.24em] text-cyan-200">Contact</p>
        <h2 class="mt-4 font-display text-4xl font-semibold text-white">Start with one high-friction workflow.</h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-300">
          If you need AI to improve a real queue, real service flow, or real operating process, we can start with a
          scoped audit and a concrete pilot plan.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="mailto:hello@innovaconsult.ai"
            class="rounded-full bg-cyan-400 px-7 py-3 font-semibold text-slate-950 transition hover:bg-cyan-300"
          >
            hello@innovaconsult.ai
          </a>
          <a
            href="https://t.me/mmixua"
            class="rounded-full border border-slate-700 px-7 py-3 font-semibold text-slate-100 transition hover:border-cyan-300 hover:text-cyan-200"
          >
            Telegram
          </a>
        </div>
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
</BaseLayout>
